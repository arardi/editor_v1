<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/editorRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/za_background"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="12dp">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@color/za_transparent"
            android:padding="12dp"
            android:src="@drawable/ic_back"
            android:tint="@color/za_text_primary" />

        <TextView
            android:id="@+id/editorProjectTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/za_text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/exportButton"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@color/za_transparent"
            android:padding="12dp"
            android:src="@drawable/ic_export"
            android:tint="@color/za_primary" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/previewContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_weight="1"
        android:background="@drawable/bg_video"
        android:clipChildren="true"
        android:clipToPadding="true">

        <androidx.media3.ui.PlayerView
            android:id="@+id/playerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:background="@android:color/transparent"
            app:resize_mode="fit"
            app:show_buffering="when_playing"
            app:shutter_background_color="@android:color/transparent"
            app:use_controller="false" />

        <View
            android:id="@+id/overlayColorView"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:visibility="gone" />

        <View
            android:id="@+id/overlayDragHandle"
            android:layout_width="28dp"
            android:layout_height="5dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_overlay_handle"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/playbackRow"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <ImageButton
            android:id="@+id/playPauseButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_chip"
            android:padding="9dp"
            android:src="@drawable/ic_play"
            android:tint="@color/za_text_primary" />

        <TextView
            android:id="@+id/currentTimeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textColor="@color/za_text_primary"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:text="/"
            android:textColor="@color/za_text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/durationText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/za_text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/timelineToggle"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_panel_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="Timeline"
            android:textColor="@color/za_primary"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/editorPanelContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <LinearLayout
            android:id="@+id/timelinePanel"
            android:layout_width="match_parent"
            android:layout_height="@dimen/timeline_container_height"
            android:background="@drawable/bg_timeline"
            android:orientation="vertical"
            android:visibility="gone">

            <eu.linkzhe.zaeditor.TimelineView
                android:id="@+id/timelineView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/transformPanel"
            android:layout_width="match_parent"
            android:layout_height="@dimen/timeline_container_height"
            android:background="@drawable/bg_panel"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/mirrorButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_panel_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Mirror horizontal"
                android:textColor="@color/za_text_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/flipButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_panel_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Flip vertical"
                android:textColor="@color/za_text_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/backgroundPanel"
            android:layout_width="match_parent"
            android:layout_height="@dimen/timeline_container_height"
            android:background="@drawable/bg_panel"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Canvas background"
                android:textColor="@color/za_text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/backgroundColorContainer"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="10dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/overlayPanel"
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/overlayToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_panel_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="Enable overlay"
                    android:textColor="@color/za_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="Drag overlay on preview to adjust position"
                    android:textColor="@color/za_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/overlayColorContainer"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal" />

            <LinearLayout
                android:id="@+id/overlayAlphaContainer"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:gravity="center_vertical"
                android:orientation="horizontal" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/overlayTopButton"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_panel_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="Top"
                    android:textColor="@color/za_text_secondary"
                    android:textSize="11sp" />
                <TextView
                    android:id="@+id/overlayBottomButton"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_panel_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="Bottom"
                    android:textColor="@color/za_text_secondary"
                    android:textSize="11sp" />
                <TextView
                    android:id="@+id/overlayLeftButton"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_panel_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="Left"
                    android:textColor="@color/za_text_secondary"
                    android:textSize="11sp" />
                <TextView
                    android:id="@+id/overlayRightButton"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_panel_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="Right"
                    android:textColor="@color/za_text_secondary"
                    android:textSize="11sp" />
                <TextView
                    android:id="@+id/overlayCenterButton"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_panel_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="Center"
                    android:textColor="@color/za_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="74dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/toolContainer"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="6dp" />
    </HorizontalScrollView>
</LinearLayout>
