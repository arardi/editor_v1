<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="22dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/import_video"
        android:textColor="@color/za_text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Choose a video from your device to create a new project."
        android:textColor="@color/za_text_secondary"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/importVideoAction"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="22dp"
        android:background="@drawable/bg_button_primary"
        android:gravity="center"
        android:text="@string/import_video"
        android:textColor="@color/za_text_primary"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/cancelAction"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="Cancel"
        android:textColor="@color/za_text_secondary"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
